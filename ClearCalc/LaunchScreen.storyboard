                                            <constraint firstAttribute="height" constant="280" id="orbit-canvas-height" />
                                            <constraint firstItem="launch-mark" firstAttribute="centerX" secondItem="launch-orbit-canvas" secondAttribute="centerX" id="orbit-mark-centerX" />
                                            <constraint firstItem="launch-mark" firstAttribute="centerY" secondItem="launch-orbit-canvas" secondAttribute="centerY" id="orbit-mark-centerY" />
