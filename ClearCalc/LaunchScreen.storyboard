<?xml version='1.0' encoding='UTF-8'?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="24154" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch-controller">
    <device id="retina6_12" orientation="portrait" appearance="dark" />
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24150" />
        <capability name="Safe area layout guides" minToolsVersion="9.0" />
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0" />
    </dependencies>
    <scenes>
        <scene sceneID="launch-scene">
            <objects>
                <viewController id="launch-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="launch-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852" />
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" image="LaunchBackground" translatesAutoresizingMaskIntoConstraints="NO" id="launch-background">
                                <rect key="frame" x="0.0" y="0.0" width="393" height="852" />
                            </imageView>
                            <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" alignment="center" spacing="22" translatesAutoresizingMaskIntoConstraints="NO" id="launch-brand">
                                <rect key="frame" x="56.5" y="224" width="280" height="370" />
                                <subviews>
                                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="launch-orbit-canvas">
                                        <rect key="frame" x="0" y="0" width="280" height="280" />
                                        <subviews>
                                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="LaunchMark" translatesAutoresizingMaskIntoConstraints="NO" id="launch-mark">
                                                <rect key="frame" x="82" y="82" width="116" height="116" />
                                                <constraints>
                                                    <constraint firstAttribute="width" constant="116" id="mark-width" />
                                                    <constraint firstAttribute="height" constant="116" id="mark-height" />
                                                </constraints>
                                            </imageView>
                                            <view contentMode="scaleToFill" tag="100" translatesAutoresizingMaskIntoConstraints="NO" id="launch-orbit-ring">
                                                <rect key="frame" x="0" y="0" width="280" height="280" />
                                                <subviews>
                                                    <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" image="plus" catalog="system" translatesAutoresizingMaskIntoConstraints="NO" id="feature-calculate-icon" tag="101">
                                                        <color key="tintColor" red="0.6" green="0.65" blue="1.0" alpha="1" colorSpace="custom" customColorSpace="sRGB" />
                                                        <constraints>
                                                            <constraint firstAttribute="width" constant="22" id="feature-calculate-width" />
                                                            <constraint firstAttribute="height" constant="22" id="feature-calculate-height" />
                                                        </constraints>
                                                    </imageView>
                                                    <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" image="clock" catalog="system" translatesAutoresizingMaskIntoConstraints="NO" id="feature-time-icon" tag="102">
                                                        <color key="tintColor" red="1.0" green="0.7" blue="0.52" alpha="1" colorSpace="custom" customColorSpace="sRGB" />
                                                        <constraints>
                                                            <constraint firstAttribute="width" constant="22" id="feature-time-width" />
                                                            <constraint firstAttribute="height" constant="22" id="feature-time-height" />
                                                        </constraints>
                                                    </imageView>
                                                    <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" image="person.2" catalog="system" translatesAutoresizingMaskIntoConstraints="NO" id="feature-split-icon" tag="103">
                                                        <color key="tintColor" red="0.55" green="0.87" blue="0.76" alpha="1" colorSpace="custom" customColorSpace="sRGB" />
                                                        <constraints>
                                                            <constraint firstAttribute="width" constant="22" id="feature-split-width" />
                                                            <constraint firstAttribute="height" constant="22" id="feature-split-height" />
                                                        </constraints>
                                                    </imageView>
                                                    <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" image="arrow.left.arrow.right" catalog="system" translatesAutoresizingMaskIntoConstraints="NO" id="feature-compare-icon" tag="104">
                                                        <color key="tintColor" red="0.55" green="0.8" blue="1.0" alpha="1" colorSpace="custom" customColorSpace="sRGB" />
                                                        <constraints>
                                                            <constraint firstAttribute="width" constant="22" id="feature-compare-width" />
                                                            <constraint firstAttribute="height" constant="22" id="feature-compare-height" />
                                                        </constraints>
                                                    </imageView>
                                                </subviews>
                                                <constraints>
                                                    <constraint firstItem="feature-calculate-icon" firstAttribute="centerX" secondItem="launch-orbit-ring" secondAttribute="centerX" constant="0" id="orbit-calculate-x" />
                                                    <constraint firstItem="feature-calculate-icon" firstAttribute="centerY" secondItem="launch-orbit-ring" secondAttribute="centerY" constant="-116" id="orbit-calculate-y" />
                                                    <constraint firstItem="feature-time-icon" firstAttribute="centerX" secondItem="launch-orbit-ring" secondAttribute="centerX" constant="116" id="orbit-time-x" />
                                                    <constraint firstItem="feature-time-icon" firstAttribute="centerY" secondItem="launch-orbit-ring" secondAttribute="centerY" constant="0" id="orbit-time-y" />
                                                    <constraint firstItem="feature-split-icon" firstAttribute="centerX" secondItem="launch-orbit-ring" secondAttribute="centerX" constant="0" id="orbit-split-x" />
                                                    <constraint firstItem="feature-split-icon" firstAttribute="centerY" secondItem="launch-orbit-ring" secondAttribute="centerY" constant="116" id="orbit-split-y" />
                                                    <constraint firstItem="feature-compare-icon" firstAttribute="centerX" secondItem="launch-orbit-ring" secondAttribute="centerX" constant="-116" id="orbit-compare-x" />
                                                    <constraint firstItem="feature-compare-icon" firstAttribute="centerY" secondItem="launch-orbit-ring" secondAttribute="centerY" constant="0" id="orbit-compare-y" />
                                                </constraints>
